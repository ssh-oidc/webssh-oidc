# Copy to .env and fill in the secrets. The same file is used by the host
# dev server and by the containerized webssh-oidc service (docker/compose.yaml).

# Auth.js secret: `openssl rand -base64 32`
AUTH_SECRET=

# Public origin (http://localhost:8444 for local use).
ORIGIN=http://localhost:8444
# For a remote VM behind Caddy, also set the public URL explicitly:
# AUTH_URL=https://webssh.example.org

# Browser-facing motley-cue endpoint.
# Local default: plain HTTP (CORS enabled), so no Caddy CA needs to be trusted.
# Use https://motley-cue.localhost/ if you have trusted the Caddy local CA;
# remote deployments must use an https URL (mixed content is blocked when the
# app itself is served over https).
MC_ENDPOINT=http://localhost/motley_cue/

# Server-side motley-cue endpoint.
# Host dev (npm run dev): Caddy publishes plain HTTP on :80.
# Containerized webssh overrides this with http://caddy/motley_cue/.
INTERNAL_MC_ENDPOINT=http://localhost/motley_cue/

# SSH endpoint (used for dialing and for the displayed ssh command).
# Host dev: 1022 is the published sshd port.
# Containerized webssh overrides this with motley-cue:22.
SSH_HOSTNAME=localhost
SSH_INTERNAL_HOSTNAME=localhost
SSH_PORT=1022

# mccli (default) or oinit.
SSH_METHOD=mccli
# OINIT_ENDPOINT=http://localhost:8080/oinit/api/v1

NODE_ENV=development
# debug prints tokens, so only use it while debugging
LOG_LEVEL=info
